<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import com.ejemplo.tallerpro.util.PaginadorBusqueda?>
<?import javafx.scene.layout.*?>
<?import com.ejemplo.tallerpro.util.ComboBuscable?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ejemplo.tallerpro.controller.MantenimientoController"
      spacing="10.0">
    <padding><Insets top="20.0" right="28.0" bottom="10.0" left="28.0"/></padding>

    <VBox spacing="2.0">
        <Label text="Recordatorios de mantenimiento" styleClass="pagina-titulo"/>
        <Label text="Programa servicios periódicos (por km o por meses) y avisa a los clientes que deben volver"
               styleClass="pagina-sub"/>
    </VBox>

    <VBox styleClass="tarjeta" spacing="10.0" VBox.vgrow="ALWAYS">
        <Label text="Mantenimientos programados" styleClass="tarjeta-titulo"/>
        <FlowPane hgap="10" vgap="6" alignment="CENTER_LEFT">
            <Button text="Nuevo" onAction="#onNuevo" minWidth="-Infinity" styleClass="button-outlined,accion-principal"/>
            <TextField fx:id="txtBuscar" prefWidth="240.0" promptText="Buscar placa, cliente o servicio"/>
            <CheckBox fx:id="chkPendientes" text="Solo pendientes"/>
        </FlowPane>
        <TableView fx:id="tabla" VBox.vgrow="ALWAYS" minHeight="110" styleClass="striped">
            <columns>
                <TableColumn fx:id="colPlaca" text="Placa" prefWidth="77"/>
                <TableColumn fx:id="colCliente" text="Cliente" prefWidth="107"/>
                <TableColumn fx:id="colServicio" text="Servicio" prefWidth="118"/>
                <TableColumn fx:id="colPlan" text="Frecuencia" prefWidth="107"/>
                <TableColumn fx:id="colUltimo" text="Último servicio" prefWidth="116"/>
                <TableColumn fx:id="colRestante" text="Restante" prefWidth="160"/>
                <TableColumn fx:id="colEstadoMant" text="Estado" prefWidth="95"/>
            </columns>
        </TableView>
        <PaginadorBusqueda fx:id="paginador"/>
    </VBox>

    <VBox fx:id="ficha" styleClass="tarjeta,ficha-datos" spacing="8.0">
        <Label text="Programar mantenimiento" styleClass="tarjeta-titulo"/>

        <GridPane hgap="14.0" vgap="7.0">
            <columnConstraints>
                <ColumnConstraints minWidth="158.0"/>
                <ColumnConstraints prefWidth="260.0" hgrow="ALWAYS"/>
                <ColumnConstraints minWidth="158.0"/>
                <ColumnConstraints prefWidth="260.0"/>
            </columnConstraints>

            <Label text="Vehículo *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <ComboBuscable fx:id="cmbVehiculo" maxWidth="Infinity" promptText="Selecciona un vehículo"
                      GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Servicio *" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
            <TextField fx:id="txtServicio" promptText="Ej. Cambio de aceite"
                       GridPane.rowIndex="0" GridPane.columnIndex="3"/>

            <Label text="Cada (km)" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="txtCadaKm" promptText="Ej. 5000 (0 = no aplica)"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Cada (meses)" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
            <TextField fx:id="txtCadaMeses" promptText="Ej. 6 (0 = no aplica)"
                       GridPane.rowIndex="1" GridPane.columnIndex="3"/>

            <Label text="Km del último servicio *" wrapText="true" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="txtUltimoKm" promptText="Km cuando se hizo"
                       GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Fecha del último servicio *" wrapText="true" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
            <DatePicker fx:id="dpUltimaFecha" GridPane.rowIndex="2" GridPane.columnIndex="3"/>
        </GridPane>

        <FlowPane hgap="10" vgap="6" alignment="CENTER_LEFT">
            <Button text="Guardar" onAction="#onGuardar" minWidth="-Infinity" styleClass="accent,accion-principal"/>
            <Button fx:id="btnRealizado" text="Marcar como realizado hoy" onAction="#onRealizado" minWidth="-Infinity" styleClass="success,accion-secundaria"/>
            <Button fx:id="btnRecordar" text="Recordar por WhatsApp" onAction="#onWhatsApp" minWidth="-Infinity" styleClass="button-outlined,accion-secundaria"/>
            <Button fx:id="btnEliminar" text="Eliminar" onAction="#onEliminar" minWidth="-Infinity" styleClass="danger,accion-secundaria"/>
        </FlowPane>
    </VBox>

    <HBox styleClass="barra-estado">
        <padding><Insets top="8.0" right="4.0" bottom="8.0" left="4.0"/></padding>
        <Label fx:id="lblEstado" text="Listo."/>
    </HBox>
</VBox>
