<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.ejemplo.tallerpro.util.ComboBuscable?>
<?import com.ejemplo.tallerpro.util.PaginadorBusqueda?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="vistaCompras" fx:controller="com.ejemplo.tallerpro.controller.CompraController" spacing="12">
    <padding><Insets top="24" right="28" bottom="12" left="28"/></padding>
    <Label text="Compras" styleClass="pagina-titulo"/>
    <VBox spacing="8" styleClass="tarjeta" VBox.vgrow="ALWAYS">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="Nueva compra" onAction="#onNueva" minWidth="-Infinity" styleClass="accent,accion-principal"/>
            <TextField fx:id="txtBuscar" prefWidth="290" promptText="Buscar por proveedor o comprobante"/>
        </HBox>
        <TableView fx:id="tabla" VBox.vgrow="ALWAYS" minHeight="112">
                <columns>
                    <TableColumn fx:id="colFecha" text="Fecha" minWidth="107" prefWidth="112"/>
                    <TableColumn fx:id="colComprobante" text="Comprobante" minWidth="270" prefWidth="303"/>
                    <TableColumn fx:id="colProveedor" text="Proveedor" prefWidth="158"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="110"/>
                    <TableColumn fx:id="colTotal" text="Total" prefWidth="112"/>
                </columns>
            </TableView>
            <PaginadorBusqueda fx:id="paginador"/>
        </VBox>
    <VBox fx:id="ficha" spacing="8" styleClass="tarjeta">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label fx:id="lblCompra" styleClass="tarjeta-titulo"/>
            </HBox>
        <VBox fx:id="lectura" spacing="6">
            <GridPane hgap="16" vgap="5">
                <Label text="Proveedor" styleClass="leyenda"/>
                <Label fx:id="lblProveedorLectura" wrapText="true" GridPane.columnIndex="1"/>
                <Label text="Comprobante" styleClass="leyenda" GridPane.rowIndex="1"/>
                <Label fx:id="lblComprobanteLectura" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="Fecha" styleClass="leyenda" GridPane.rowIndex="2"/>
                <Label fx:id="lblFechaLectura" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            </GridPane>
        </VBox>
            <VBox fx:id="editor" spacing="8">
                <GridPane hgap="8" vgap="7">
                    <columnConstraints>
                        <ColumnConstraints minWidth="84"/>
                        <ColumnConstraints hgrow="ALWAYS" fillWidth="true"/>
                        <ColumnConstraints minWidth="66"/>
                        <ColumnConstraints prefWidth="136"/>
                    </columnConstraints>
                    <Label text="Proveedor" GridPane.rowIndex="0"/>
                    <ComboBuscable fx:id="cmbProveedor" promptText="Nombre o RUC" maxWidth="Infinity"
                                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label text="Fecha" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <DatePicker fx:id="dpFecha" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                    <Label text="Comprobante" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtComprobante" promptText="Número"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <Label text="Tipo" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <ComboBox fx:id="cmbTipo" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                </GridPane>
                <Separator/>
                <ComboBuscable fx:id="cmbRepuesto" promptText="Buscar repuesto por nombre o SKU"/>
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <TextField fx:id="txtCantidad" promptText="Cantidad" prefColumnCount="7" HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="txtCosto" promptText="Costo unitario" prefColumnCount="9" HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="txtVenta" promptText="Venta sugerida" prefColumnCount="9" HBox.hgrow="ALWAYS"/>
                </HBox>
                <HBox spacing="6">
                    <Button text="Agregar o actualizar" onAction="#onAgregar" minWidth="-Infinity" styleClass="button-outlined,accion-secundaria"/>
                    <Button text="Quitar partida" onAction="#onQuitar" minWidth="-Infinity" styleClass="button-outlined,accion-secundaria"/>
                </HBox>
                <CheckBox fx:id="chkAplicarPrecios" text="Aplicar precios sugeridos al confirmar"/>
            </VBox>
            <TableView fx:id="tablaDetalles" minHeight="100" prefHeight="128">
                <columns>
                    <TableColumn fx:id="colRepuesto" text="Repuesto" prefWidth="323"/>
                    <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="98"/>
                    <TableColumn fx:id="colCosto" text="Costo unitario" prefWidth="134"/>
                    <TableColumn fx:id="colSugerido" text="Venta sugerida" prefWidth="145"/>
                </columns>
            </TableView>
            <FlowPane hgap="10" vgap="6" alignment="CENTER_LEFT">
                <Label fx:id="lblTotal" minWidth="-Infinity" styleClass="total,importe"/>
                <Button fx:id="btnGuardar" text="Guardar borrador" onAction="#onGuardar" minWidth="-Infinity" styleClass="button-outlined,accion-secundaria"/>
                <Button fx:id="btnConfirmar" text="Confirmar" onAction="#onConfirmar" minWidth="-Infinity" styleClass="accent,accion-principal"/>
                <Button fx:id="btnAnular" text="Anular" onAction="#onAnular" minWidth="-Infinity" styleClass="danger,accion-secundaria"/>
            </FlowPane>
    </VBox>
    <Label fx:id="lblEstado" wrapText="true" styleClass="pagina-sub"/>
</VBox>
