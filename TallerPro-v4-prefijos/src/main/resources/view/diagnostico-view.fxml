<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.ejemplo.tallerpro.util.ComboBuscable?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ejemplo.tallerpro.controller.DiagnosticoController"
      spacing="14.0">
    <padding><Insets top="24.0" right="28.0" bottom="10.0" left="28.0"/></padding>

    <VBox spacing="2.0">
        <Label text="Diagnóstico" styleClass="pagina-titulo"/>
        <Label text="Describe los síntomas del vehículo para obtener orientación."
               styleClass="pagina-sub" wrapText="true"/>
    </VBox>

    <VBox styleClass="tarjeta" spacing="10.0">
        <Label text="Tu consulta" styleClass="tarjeta-titulo"/>
        <HBox spacing="12.0" alignment="CENTER_LEFT">
            <Label text="Vehículo (opcional)"/>
            <ComboBuscable fx:id="cmbVehiculo" prefWidth="420.0" promptText="Busca el vehículo por placa"/>
        </HBox>
        <TextArea fx:id="txtSintomas" prefRowCount="4" wrapText="true"
                  promptText="Ej. Hace un ruido metálico al frenar y el pedal vibra a más de 60 km/h. ¿Qué puede ser y cómo se soluciona?"/>
        <FlowPane hgap="10" vgap="6" alignment="CENTER_LEFT">
            <Button fx:id="btnConsultar" text="Enviar" onAction="#onConsultar" minWidth="-Infinity"
                    styleClass="accent,accion-principal"/>
            <Button fx:id="btnNuevaConsulta" text="Nueva consulta" onAction="#onNuevaConsulta" minWidth="-Infinity"
                    styleClass="button-outlined,accion-secundaria"/>
            <ProgressIndicator fx:id="progreso" prefWidth="24.0" prefHeight="24.0"/>
        </FlowPane>
    </VBox>

    <VBox styleClass="tarjeta" spacing="10.0" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT">
            <Label text="Conversación" styleClass="tarjeta-titulo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Copiar" onAction="#onCopiar" minWidth="-Infinity" styleClass="button-outlined,accion-secundaria"/>
        </HBox>
        <TextArea fx:id="txtRespuesta" editable="false" wrapText="true" VBox.vgrow="ALWAYS"
                  styleClass="respuesta-ia"
                  promptText="Aquí aparecerá la respuesta. Confirma la orientación con una inspección física."/>
    </VBox>

    <HBox styleClass="barra-estado">
        <padding><Insets top="8.0" right="4.0" bottom="8.0" left="4.0"/></padding>
        <Label fx:id="lblEstado" text="Listo." wrapText="true"/>
    </HBox>
</VBox>
