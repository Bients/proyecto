<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.ejemplo.tallerpro.util.PaginadorBusqueda?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ejemplo.tallerpro.controller.ClienteController"
      spacing="10.0">
    <padding><Insets top="20.0" right="28.0" bottom="10.0" left="28.0"/></padding>

    <VBox spacing="2.0">
        <Label text="Clientes" styleClass="pagina-titulo"/>
        <Label text="Datos de contacto de los dueños de los vehículos" styleClass="pagina-sub"/>
    </VBox>

    <VBox fx:id="listado" styleClass="tarjeta" spacing="10.0" VBox.vgrow="ALWAYS">
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <Button fx:id="btnNuevo" text="Nuevo" onAction="#onNuevo" minWidth="-Infinity"
                    styleClass="button-outlined,accion-principal"/>
            <TextField fx:id="txtBuscar" prefWidth="280.0"
                       promptText="Nombre, apellido, DNI o teléfono"/>
        </HBox>
        <TableView fx:id="tabla" VBox.vgrow="ALWAYS" minHeight="135" styleClass="striped">
            <columns>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="160.0"/>
                <TableColumn fx:id="colApellido" text="Apellido" prefWidth="160.0"/>
                <TableColumn fx:id="colDni" text="DNI" prefWidth="95.0"/>
                <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="105.0"/>
                <TableColumn fx:id="colEmail" text="Correo" prefWidth="260.0"/>
            </columns>
        </TableView>
        <PaginadorBusqueda fx:id="paginador"/>
    </VBox>

    <VBox fx:id="ficha" styleClass="tarjeta,ficha-datos" spacing="8.0">
        <Label fx:id="lblFicha" text="Datos del cliente" styleClass="tarjeta-titulo"/>

        <GridPane hgap="14.0" vgap="7.0">
            <columnConstraints>
                <ColumnConstraints minWidth="90.0"/>
                <ColumnConstraints prefWidth="240.0" hgrow="ALWAYS"/>
                <ColumnConstraints minWidth="90.0"/>
                <ColumnConstraints prefWidth="240.0" hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="DNI *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtDni" promptText="8 dígitos · búsqueda automática"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Teléfono" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
            <TextField fx:id="txtTelefono" promptText="9 dígitos (opcional)"
                       GridPane.rowIndex="0" GridPane.columnIndex="3"/>

            <Label text="Nombre *" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="txtNombre" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Apellido *" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
            <TextField fx:id="txtApellido" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

            <Label text="Correo" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="txtEmail" promptText="opcional"
                       GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.columnSpan="3"/>
        </GridPane>

        <Label fx:id="lblDni" wrapText="true" styleClass="pagina-sub" visible="false" managed="false"/>
        <Label fx:id="lblVehiculos" wrapText="true" styleClass="pagina-sub" visible="false" managed="false"/>

        <FlowPane hgap="10" vgap="6" alignment="CENTER_LEFT">
            <Button fx:id="btnGuardar" text="Guardar" onAction="#onGuardar" minWidth="-Infinity"
                    styleClass="accent,accion-principal"/>
            <Button fx:id="btnCerrar" text="Cerrar ficha" onAction="#onCerrar" minWidth="-Infinity"
                    styleClass="button-outlined,accion-secundaria"/>
            <Button fx:id="btnOtroDni" text="Otro DNI" onAction="#onNuevo" minWidth="-Infinity"
                    visible="false" managed="false" styleClass="button-outlined,accion-secundaria"/>
            <Button fx:id="btnEliminar" text="Eliminar" onAction="#onEliminar" minWidth="-Infinity"
                    styleClass="danger,accion-secundaria"/>
        </FlowPane>
    </VBox>

    <HBox styleClass="barra-estado">
        <padding><Insets top="8.0" right="4.0" bottom="8.0" left="4.0"/></padding>
        <Label fx:id="lblEstado" text="Listo."/>
    </HBox>
</VBox>
